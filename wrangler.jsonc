{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "school-app",
  // Bump this whenever you redeploy long after setup — today's date is fine.
  "compatibility_date": "2026-08-01",
  "main": "src/index.js",

  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // No "id" here on purpose: Cloudflare automatically creates this KV
  // namespace for you on first deploy (whether via `wrangler deploy` or
  // the dashboard's GitHub auto-deploy) and binds it under this name.
  // If you'd rather create it yourself, see README.md for the manual
  // dashboard steps, which just add an "id" field here.
  "kv_namespaces": [
    { "binding": "SCHOOL_KV" }
  ],

  // Checks for due assignments every 15 minutes and sends push reminders.
  "triggers": {
    "crons": ["*/15 * * * *"]
  },

  "vars": {
    // Public VAPID key — safe to commit, not a secret.
    // Generate both keys with scripts/generate-vapid-keys.html (open it
    // in any browser, no install needed) and paste the public one here.
    "VAPID_PUBLIC_KEY": "BLzuu1s99LV7RvdedLbOtnxrV95CjnS_7Faf2ZqO5ZIFCsMVuKJQGeTwskbD5Y8PnZWLMZIMI-Zk27Vtj_8TEZs",
    // Shown to push services as the contact for this app; any email works.
    "VAPID_SUBJECT": "mailto:you@example.com"
  }

  // VAPID_PRIVATE_JWK is a secret and does NOT go in this file — set it
  // from the Cloudflare dashboard after your first deploy: your Worker ->
  // Settings -> Variables and Secrets -> Add -> type "Secret". See
  // README.md for the full walkthrough.
}
